			REPEAT = 2;
			LEVEL 0 FOR 4000.0;
			LEVEL 1 FOR 4000.0;
		}
	}
}

TRANSITION_LIST("Q")
{
	NODE
	{
		REPEAT = 1;
		LEVEL 0 FOR 16000.0;
	}
}

TRANSITION_LIST("J")
{
	NODE
	{
		REPEAT = 1;
		NODE
		{
			REPEAT = 4;
			LEVEL 0 FOR 2000.0;
			LEVEL 1 FOR 2000.0;
		}
	}
}

