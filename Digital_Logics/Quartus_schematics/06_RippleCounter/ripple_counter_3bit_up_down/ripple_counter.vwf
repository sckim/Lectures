/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off 3bit_ripple -c 3bit_ripple --vector_source="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/3bit_ripple/3bit_ripple.vwf" --testbench_file="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/3bit_ripple/simulation/qsim/3bit_ripple.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off 3bit_ripple -c 3bit_ripple --vector_source="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/3bit_ripple/3bit_ripple.vwf" --testbench_file="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/3bit_ripple/simulation/qsim/3bit_ripple.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/3bit_ripple/simulation/qsim/" 3bit_ripple -c 3bit_ripple</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/3bit_ripple/simulation/qsim/" 3bit_ripple -c 3bit_ripple</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work 3bit_ripple.vho
vcom -work work 3bit_ripple.vwf.vht
vsim -novopt -c -t 1ps -L cyclonev -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.3bit_ripple_vhd_vec_tst
vcd file -direction 3bit_ripple.msim.vcd
vcd add -internal 3bit_ripple_vhd_vec_tst/*
vcd add -internal 3bit_ripple_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f

</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work 3bit_ripple.vho
vcom -work work 3bit_ripple.vwf.vht
vsim -novopt -c -t 1ps -sdfmax 3bit_ripple_vhd_vec_tst/i1=3bit_ripple_vhd.sdo -L cyclonev -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.3bit_ripple_vhd_vec_tst
vcd file -direction 3bit_ripple.msim.vcd
vcd add -internal 3bit_ripple_vhd_vec_tst/*
vcd add -internal 3bit_ripple_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f

</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/
