/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off 2digitsSeg -c 2digitsSeg --vector_source="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/6_Counter/2digits using 7447/2digitsSeg.vwf" --testbench_file="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/6_Counter/2digits using 7447/simulation/qsim/2digitsSeg.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off 2digitsSeg -c 2digitsSeg --vector_source="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/6_Counter/2digits using 7447/2digitsSeg.vwf" --testbench_file="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/6_Counter/2digits using 7447/simulation/qsim/2digitsSeg.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/6_Counter/2digits using 7447/simulation/qsim/" 2digitsSeg -c 2digitsSeg</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="D:/Github/0_Lectures/Digital_Logics/Quartus_schematics/6_Counter/2digits using 7447/simulation/qsim/" 2digitsSeg -c 2digitsSeg</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work 2digitsSeg.vho
vcom -work work 2digitsSeg.vwf.vht
vsim -novopt -c -t 1ps -L cyclonev -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.2digitsSeg_vhd_vec_tst
vcd file -direction 2digitsSeg.msim.vcd
vcd add -internal 2digitsSeg_vhd_vec_tst/*
vcd add -internal 2digitsSeg_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f
</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work 2digitsSeg.vho
vcom -work work 2digitsSeg.vwf.vht
vsim -novopt -c -t 1ps -sdfmax 2digitsSeg_vhd_vec_tst/i1=2digitsSeg_vhd.sdo -L cyclonev -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.2digitsSeg_vhd_vec_tst
vcd file -direction 2digitsSeg.msim.vcd
vcd add -internal 2digitsSeg_vhd_vec_tst/*
vcd add -internal 2digitsSeg_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f
</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/
