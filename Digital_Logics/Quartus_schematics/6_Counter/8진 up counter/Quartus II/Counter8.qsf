# The default values for assignments are stored in the file
#		Counter8_assignment_defaults.qdf
# If this file doesn't exist, and for assignments not listed, see file
#		assignment_defaults.qdf

# Altera recommends that you do not modify this file. This
# file is updated automatically by the Quartus II software
# and any changes you make may be lost or overwritten.


# Project-Wide Assignments
# ========================
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 5.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "18:22:23  DECEMBER 26, 2005"
set_global_assignment -name LAST_QUARTUS_VERSION "9.1 SP2"

# Pin & Location Assignments
# ==========================

# Analysis & Synthesis Assignments
# ================================
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name TOP_LEVEL_ENTITY Counter8

# Fitter Assignments
# ==================
set_global_assignment -name DEVICE EP2C35F672C6
set_global_assignment -name RESERVE_ASDO_AFTER_CONFIGURATION "AS OUTPUT DRIVING AN UNSPECIFIED SIGNAL"
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1

# Assembler Assignments
# =====================
set_global_assignment -name AUTO_RESTART_CONFIGURATION OFF

# Simulator Assignments
# =====================
set_global_assignment -name SIMULATION_MODE TIMING

set_global_assignment -name LL_ROOT_REGION ON -section_id "Root Region"
set_global_assignment -name LL_MEMBER_STATE LOCKED -section_id "Root Region"
set_global_assignment -name INCREMENTAL_VECTOR_INPUT_SOURCE Counter8.vwf
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_location_assignment PIN_AF10 -to pin_name5
set_location_assignment PIN_AB12 -to pin_name6
set_location_assignment PIN_AC12 -to pin_name7
set_location_assignment PIN_AD11 -to pin_name8
set_location_assignment PIN_AE11 -to pin_name9
set_location_assignment PIN_V14 -to pin_name10
set_location_assignment PIN_V13 -to pin_name11
set_global_assignment -name MISC_FILE "D:/sckim/6.SampleCode/FPGA/VHDL/3.Counter/Schematics/8Áø up counter/Quartus II/Counter8.dpf"
set_location_assignment PIN_V20 -to pin_name13
set_location_assignment PIN_V21 -to pin_name14
set_location_assignment PIN_W21 -to pin_name15
set_location_assignment PIN_Y22 -to pin_name16
set_location_assignment PIN_AA24 -to pin_name17
set_location_assignment PIN_AA23 -to pin_name18
set_location_assignment PIN_AB24 -to pin_name19
set_location_assignment PIN_N25 -to pin_name
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name USE_CONFIGURATION_DEVICE ON
set_global_assignment -name VHDL_FILE Mod50MHz.vhd
set_global_assignment -name BDF_FILE Counter8.bdf
set_global_assignment -name VECTOR_WAVEFORM_FILE Counter8.vwf
set_location_assignment PIN_N2 -to pin_name12
set_global_assignment -name QIP_FILE lpm_counter2.qip