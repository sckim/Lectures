--2 is 2 at LC1
2_reg_input = VCC;
2_p2_out = 1 & 3;
2 = TFFE(2_reg_input, !1, !2_p2_out, , );


--3 is 3 at LC2
3_reg_input = VCC;
3_p2_out = 1 & 3;
3 = TFFE(3_reg_input, !2, !3_p2_out, , );


--1 is 1 at LC3
1_reg_input = VCC;
1_p2_out = 1 & 3;
1 = TFFE(1_reg_input, !GLOBAL(cp), !1_p2_out, , );


--A1L7 is 23~14 at LC5
A1L7_p1_out = 1 & 3;
A1L7_or_out = A1L7_p1_out;
A1L7 = !(A1L7_or_out);


--cp is cp at PIN_43
--operation mode is input

cp = INPUT();


--21 is 21 at PIN_4
--operation mode is output

21 = OUTPUT(2);


--22 is 22 at PIN_5
--operation mode is output

22 = OUTPUT(3);


--20 is 20 at PIN_6
--operation mode is output

20 = OUTPUT(1);


--Clr is Clr at PIN_8
--operation mode is output

Clr = OUTPUT(A1L7);






