--2 is 2
2_reg_input = VCC;
2_p2_out = 1 & 3;
2 = TFFE(2_reg_input, !1, !2_p2_out, , );


--3 is 3
3_reg_input = VCC;
3_p2_out = 1 & 3;
3 = TFFE(3_reg_input, !2, !3_p2_out, , );


--1 is 1
1_reg_input = VCC;
1_p2_out = 1 & 3;
1 = TFFE(1_reg_input, !GLOBAL(cp), !1_p2_out, , );


--A1L7 is 23~14
A1L7_p1_out = 1 & 3;
A1L7_or_out = A1L7_p1_out;
A1L7 = !(A1L7_or_out);


--cp is cp
--operation mode is input

cp = INPUT();


--21 is 21
--operation mode is output

21 = OUTPUT(2);


--22 is 22
--operation mode is output

22 = OUTPUT(3);


--20 is 20
--operation mode is output

20 = OUTPUT(1);


--Clr is Clr
--operation mode is output

Clr = OUTPUT(A1L7);


