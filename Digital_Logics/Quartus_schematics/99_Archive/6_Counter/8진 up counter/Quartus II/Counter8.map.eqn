--1 is 1
--operation mode is normal

1_lut_out = !1;
1 = DFFEAS(1_lut_out, SW7, VCC, , 4, , , , );


--2 is 2
--operation mode is normal

2_lut_out = !2;
2 = DFFEAS(2_lut_out, SW7, VCC, , 3, , , , );


--3 is 3
--operation mode is normal

3_lut_out = !3;
3 = DFFEAS(3_lut_out, SW7, VCC, , , , , , );


--4 is 4
--operation mode is normal

4 = 2 & 3;


--SW7 is SW7
--operation mode is input

SW7 = INPUT();


--QQ[1] is QQ[1]
--operation mode is output

QQ[1] = OUTPUT(1);


--QQ[2] is QQ[2]
--operation mode is output

QQ[2] = OUTPUT(2);


--QQ[3] is QQ[3]
--operation mode is output

QQ[3] = OUTPUT(3);


