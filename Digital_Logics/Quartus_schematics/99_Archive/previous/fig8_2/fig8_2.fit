CHIP "fig8_2"
BEGIN

    DEVICE = "EPM7032SLC44-5";

    "AEBI"                         : INPUT_PIN  = 16     ; -- LC11
    "AGBI"                         : INPUT_PIN  = 18     ; -- LC13
    "ALBI"                         : INPUT_PIN  = 17     ; -- LC12
    "A0"                           : INPUT_PIN  = 5      ; -- LC2
    "A1"                           : INPUT_PIN  = 4      ; -- LC1
    "A2"                           : INPUT_PIN  = 14     ; -- LC10
    "A3"                           : INPUT_PIN  = 6      ; -- LC3
    "B0"                           : INPUT_PIN  = 8      ; -- LC5
    "B1"                           : INPUT_PIN  = 9      ; -- LC6
    "B2"                           : INPUT_PIN  = 11     ; -- LC7
    "B3"                           : INPUT_PIN  = 12     ; -- LC8
    "AEBO"                         : OUTPUT_PIN = 41     ; -- LC17
    "AGBO"                         : OUTPUT_PIN = 39     ; -- LC19
    "ALBO"                         : OUTPUT_PIN = 34     ; -- LC23
    "|7485:1|p7485:sub|:74"        : LOCATION   = LC22   ; -- PIN 36
    "|7485:1|p7485:sub|:75"        : LOCATION   = LC21   ; -- PIN 37
    "|7485:1|p7485:sub|:76"        : LOCATION   = LC20   ; -- PIN 38
    "|7485:1|p7485:sub|:77"        : LOCATION   = LC18   ; -- PIN 40

END;

INTERNAL_INFO "fig8_2"
BEGIN
	DEVICE = EPM7032SLC44-5;
	LC23    : LORAX = "G32R0";
	LC19    : LORAX = "G15R0";
	LC17    : LORAX = "G13R0";
	LC22    : LORAX = "G31R0,PA14R0C1";
	OH7R0P12 : LORAX = "G63R0,PA33R0C1";
	OH2R0P6 : LORAX = "G45R0,PA22R0C1";
	LC21    : LORAX = "G30R0,PA16R0C1";
	OH6R0P11 : LORAX = "G62R0,PA31R0C1";
	OH9R0P14 : LORAX = "G1R0,PA4R0C1";
	LC20    : LORAX = "G16R0,PA1R0C1";
	OH5R0P9 : LORAX = "G61R0,PA28R0C1";
	OH0R0P4 : LORAX = "G43R0,PA20R0C1";
	LC18    : LORAX = "G14R0,PA6R0C1";
	OH4R0P8 : LORAX = "G60R0,PA29R0C1";
	OH1R0P5 : LORAX = "G44R0,PA19R0C1";
	OH10R0P16 : LORAX = "G2R0,PA0R0C1";
	OH12R0P18 : LORAX = "G17R0,PA15R0C1";
	OH11R0P17 : LORAX = "G3R0,PA3R0C1";
END;
