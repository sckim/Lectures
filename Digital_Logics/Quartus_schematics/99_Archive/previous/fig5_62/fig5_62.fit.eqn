--A1L4 is Mux~60 at LCCOMB_X1_Y2_N12
A1L4 = c & (a # b) # !c & a & b;


--b is b at PIN_L4
--operation mode is input

b = INPUT();


--a is a at PIN_N4
--operation mode is input

a = INPUT();


--c is c at PIN_P3
--operation mode is input

c = INPUT();


--x is x at PIN_M4
--operation mode is output

x = OUTPUT(A1L4);





