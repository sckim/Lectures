CHIP "ex7_28"
BEGIN

    DEVICE = "EPM7032SLC44-5";

    "add_sub"                      : INPUT_PIN  = 5      ; -- LC2
    "a0"                           : INPUT_PIN  = 8      ; -- LC5
    "a1"                           : INPUT_PIN  = 6      ; -- LC3
    "a2"                           : INPUT_PIN  = 19     ; -- LC14
    "a3"                           : INPUT_PIN  = 18     ; -- LC13
    "a4"                           : INPUT_PIN  = 21     ; -- LC16
    "a5"                           : INPUT_PIN  = 41     ; -- LC17
    "a6"                           : INPUT_PIN  = 40     ; -- LC18
    "a7"                           : INPUT_PIN  = 37     ; -- LC21
    "b0"                           : INPUT_PIN  = 36     ; -- LC22
    "b1"                           : INPUT_PIN  = 20     ; -- LC15
    "b2"                           : INPUT_PIN  = 17     ; -- LC12
    "b3"                           : INPUT_PIN  = 16     ; -- LC11
    "b4"                           : INPUT_PIN  = 14     ; -- LC10
    "b5"                           : INPUT_PIN  = 12     ; -- LC8
    "b6"                           : INPUT_PIN  = 11     ; -- LC7
    "b7"                           : INPUT_PIN  = 9      ; -- LC6
    "cin"                          : INPUT_PIN  = 27     ; -- LC29
    "cout"                         : OUTPUT_PIN = 26     ; -- LC30
    "results0"                     : OUTPUT_PIN = 24     ; -- LC32
    "results1"                     : OUTPUT_PIN = 4      ; -- LC1
    "results2"                     : OUTPUT_PIN = 39     ; -- LC19
    "results3"                     : OUTPUT_PIN = 34     ; -- LC23
    "results4"                     : OUTPUT_PIN = 33     ; -- LC24
    "results5"                     : OUTPUT_PIN = 31     ; -- LC26
    "results6"                     : OUTPUT_PIN = 29     ; -- LC27
    "results7"                     : OUTPUT_PIN = 28     ; -- LC28
    "|LPM_ADD_SUB:1|addcore:adder|g2cp2" : LOCATION   = LC17   ; -- PIN 41
    "|LPM_ADD_SUB:1|addcore:adder|g4" : LOCATION   = LC21   ; -- PIN 37
    "|LPM_ADD_SUB:1|datab_node0"   : LOCATION   = LC18   ; -- PIN 40
    "|LPM_ADD_SUB:1|datab_node1"   : LOCATION   = LC20   ; -- PIN 38
    "|LPM_ADD_SUB:1|datab_node2"   : LOCATION   = LC25   ; -- PIN 32
    "|LPM_ADD_SUB:1|datab_node3"   : LOCATION   = LC22   ; -- PIN 36
    "|LPM_ADD_SUB:1|datab_node4"   : LOCATION   = LC29   ; -- PIN 27
    "|LPM_ADD_SUB:1|datab_node5"   : LOCATION   = LC31   ; -- PIN 25
    "|LPM_ADD_SUB:1|datab_node6"   : LOCATION   = LC2    ; -- PIN 5
    "|LPM_ADD_SUB:1|datab_node7"   : LOCATION   = LC4    ; -- PIN 7

END;

