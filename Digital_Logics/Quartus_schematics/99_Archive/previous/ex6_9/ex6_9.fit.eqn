--A1L31 is inst5~16 at LCCOMB_X1_Y5_N0
A1L31 = A[2] & B[2] & (B[0] $ !A[0]) # !A[2] & !B[2] & (B[0] $ !A[0]);


--inst2 is inst2 at LCCOMB_X1_Y5_N6
inst2 = B[1] $ A[1];


--inst5 is inst5 at LCCOMB_X1_Y5_N28
inst5 = !inst2 & A1L31 & (B[3] $ !A[3]);


--A[0] is A[0] at PIN_27
--operation mode is input

A[0] = INPUT();


--A[2] is A[2] at PIN_24
--operation mode is input

A[2] = INPUT();


--B[2] is B[2] at PIN_28
--operation mode is input

B[2] = INPUT();


--B[0] is B[0] at PIN_17
--operation mode is input

B[0] = INPUT();


--A[3] is A[3] at PIN_18
--operation mode is input

A[3] = INPUT();


--B[3] is B[3] at PIN_21
--operation mode is input

B[3] = INPUT();


--A[1] is A[1] at PIN_22
--operation mode is input

A[1] = INPUT();


--B[1] is B[1] at PIN_25
--operation mode is input

B[1] = INPUT();


--W is W at PIN_26
--operation mode is output

W = OUTPUT(inst5);





