--A1L7 is sum1~15
A1L7 = cin $ b1 $ a1;


--A1L5 is cout~72
A1L5 = cin & (b1 # a1) # !cin & b1 & a1;


--cin is cin
--operation mode is input

cin = INPUT();


--b1 is b1
--operation mode is input

b1 = INPUT();


--a1 is a1
--operation mode is input

a1 = INPUT();


--sum1 is sum1
--operation mode is output

sum1 = OUTPUT(A1L7);


--cout is cout
--operation mode is output

cout = OUTPUT(A1L5);


