--A1L7 is sum1~15 at LCCOMB_X1_Y5_N28
A1L7 = cin $ a1 $ b1;


--A1L5 is cout~72 at LCCOMB_X1_Y5_N20
A1L5 = cin & (a1 # b1) # !cin & a1 & b1;


--cin is cin at PIN_25
--operation mode is input

cin = INPUT();


--b1 is b1 at PIN_27
--operation mode is input

b1 = INPUT();


--a1 is a1 at PIN_17
--operation mode is input

a1 = INPUT();


--sum1 is sum1 at PIN_26
--operation mode is output

sum1 = OUTPUT(A1L7);


--cout is cout at PIN_24
--operation mode is output

cout = OUTPUT(A1L5);





