--B1L1 is 74280b:inst|25~54 at LCCOMB_X1_Y5_N0
B1L1 = In[3] $ In[1] $ In[2] $ In[0];


--B1L2 is 74280b:inst|25~55 at LCCOMB_X1_Y5_N6
B1L2 = In[4] $ In[6] $ In[7] $ In[8];


--B1L3 is 74280b:inst|25~56 at LCCOMB_X1_Y5_N20
B1L3 = B1L1 $ In[5] $ B1L2;


--In[0] is In[0] at PIN_26
--operation mode is input

In[0] = INPUT();


--In[1] is In[1] at PIN_27
--operation mode is input

In[1] = INPUT();


--In[3] is In[3] at PIN_17
--operation mode is input

In[3] = INPUT();


--In[2] is In[2] at PIN_18
--operation mode is input

In[2] = INPUT();


--In[6] is In[6] at PIN_21
--operation mode is input

In[6] = INPUT();


--In[4] is In[4] at PIN_22
--operation mode is input

In[4] = INPUT();


--In[7] is In[7] at PIN_31
--operation mode is input

In[7] = INPUT();


--In[8] is In[8] at PIN_28
--operation mode is input

In[8] = INPUT();


--In[5] is In[5] at PIN_30
--operation mode is input

In[5] = INPUT();


--odd is odd at PIN_25
--operation mode is output

odd = OUTPUT(B1L3);


--even is even at PIN_24
--operation mode is output

even = OUTPUT(!B1L3);





