--B1L1 is 74280b:inst|25~54
B1L1 = In[0] $ In[1] $ In[3] $ In[2];


--B1L2 is 74280b:inst|25~55
B1L2 = In[6] $ In[4] $ In[7] $ In[8];


--B1L3 is 74280b:inst|25~56
B1L3 = B1L1 $ B1L2 $ In[5];


--In[0] is In[0]
--operation mode is input

In[0] = INPUT();


--In[1] is In[1]
--operation mode is input

In[1] = INPUT();


--In[3] is In[3]
--operation mode is input

In[3] = INPUT();


--In[2] is In[2]
--operation mode is input

In[2] = INPUT();


--In[6] is In[6]
--operation mode is input

In[6] = INPUT();


--In[4] is In[4]
--operation mode is input

In[4] = INPUT();


--In[7] is In[7]
--operation mode is input

In[7] = INPUT();


--In[8] is In[8]
--operation mode is input

In[8] = INPUT();


--In[5] is In[5]
--operation mode is input

In[5] = INPUT();


--odd is odd
--operation mode is output

odd = OUTPUT(B1L3);


--even is even
--operation mode is output

even = OUTPUT(!B1L3);


