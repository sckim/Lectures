--A1L5 is inst4~20
A1L5_p1_out = D & !C;
A1L5_p2_out = C & A;
A1L5_or_out = A1L5_p1_out # A1L5_p2_out # B;
A1L5 = A1L5_or_out;


--C is C
--operation mode is input

C = INPUT();


--B is B
--operation mode is input

B = INPUT();


--D is D
--operation mode is input

D = INPUT();


--A is A
--operation mode is input

A = INPUT();


--X is X
--operation mode is output

X = OUTPUT(A1L5);


