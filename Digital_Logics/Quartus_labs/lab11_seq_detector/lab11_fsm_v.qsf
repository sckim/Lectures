# lab11_fsm_v : 101 detector, Mealy and Moore Verilog FSMs (Part B), Quartus Prime Lite 18.1, DE1-SoC (5CSEMA5F31C6)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY det101_fsm_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name VERILOG_FILE det101_mealy.v
set_global_assignment -name VERILOG_FILE det101_moore.v
set_global_assignment -name VERILOG_FILE det101_fsm_top.v
# ---- DE1-SoC pins (DE1-SoC User Manual rev.F, Tables 3-6, 3-7, 3-8) ----
# CLK = KEY[0]
set_location_assignment PIN_AA14 -to CLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK
# ClrN = KEY[1]
set_location_assignment PIN_AA15 -to ClrN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ClrN
# X = SW[0]
set_location_assignment PIN_AB12 -to X
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to X
# Z_MEALY = LEDR[0]
set_location_assignment PIN_V16 -to Z_MEALY
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Z_MEALY
# Z_MOORE = LEDR[1]
set_location_assignment PIN_W16 -to Z_MOORE
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Z_MOORE
# ST_MEALY[0] = LEDR[4]
set_location_assignment PIN_W17 -to ST_MEALY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ST_MEALY[0]
# ST_MEALY[1] = LEDR[5]
set_location_assignment PIN_W19 -to ST_MEALY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ST_MEALY[1]
# ST_MOORE[0] = LEDR[6]
set_location_assignment PIN_Y19 -to ST_MOORE[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ST_MOORE[0]
# ST_MOORE[1] = LEDR[7]
set_location_assignment PIN_W20 -to ST_MOORE[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ST_MOORE[1]
