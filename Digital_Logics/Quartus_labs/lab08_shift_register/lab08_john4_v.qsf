# lab08_john4_v : 4-bit Johnson counter with load and self-correcting option (Part D, Verilog), Quartus Prime Lite 18.1, DE1-SoC (5CSEMA5F31C6)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY johnson4_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name VERILOG_FILE johnson.v
# ---- DE1-SoC pins (DE1-SoC User Manual rev.F, Tables 3-6, 3-7, 3-8) ----
# CLK = KEY[0]
set_location_assignment PIN_AA14 -to CLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK
# RSTN = KEY[1]
set_location_assignment PIN_AA15 -to RSTN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to RSTN
# LDN = KEY[2]
set_location_assignment PIN_W15 -to LDN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LDN
# D[0] = SW[0]
set_location_assignment PIN_AB12 -to D[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to D[0]
# D[1] = SW[1]
set_location_assignment PIN_AC12 -to D[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to D[1]
# D[2] = SW[2]
set_location_assignment PIN_AF9 -to D[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to D[2]
# D[3] = SW[3]
set_location_assignment PIN_AF10 -to D[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to D[3]
# FIX = SW[9]
set_location_assignment PIN_AE12 -to FIX
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FIX
# Q[0] = LEDR[0]
set_location_assignment PIN_V16 -to Q[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Q[0]
# Q[1] = LEDR[1]
set_location_assignment PIN_W16 -to Q[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Q[1]
# Q[2] = LEDR[2]
set_location_assignment PIN_V17 -to Q[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Q[2]
# Q[3] = LEDR[3]
set_location_assignment PIN_V18 -to Q[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Q[3]
