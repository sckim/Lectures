# lab08_piso_sch : 8-bit PISO with 74165 macro (Part B, schematic), Quartus Prime Lite 18.1, DE1-SoC (5CSEMA5F31C6)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY piso74165_sch
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name BDF_FILE piso74165_sch.bdf
# ---- DE1-SoC pins (DE1-SoC User Manual rev.F, Tables 3-6, 3-7, 3-8) ----
# Clk = KEY[0]
set_location_assignment PIN_AA14 -to Clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Clk
# Shift_load = KEY[1]
set_location_assignment PIN_AA15 -to Shift_load
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Shift_load
# A = SW[7]
set_location_assignment PIN_AC9 -to A
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A
# B = SW[6]
set_location_assignment PIN_AE11 -to B
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to B
# C = SW[5]
set_location_assignment PIN_AD12 -to C
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to C
# D = SW[4]
set_location_assignment PIN_AD11 -to D
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to D
# E = SW[3]
set_location_assignment PIN_AF10 -to E
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to E
# F = SW[2]
set_location_assignment PIN_AF9 -to F
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to F
# G = SW[1]
set_location_assignment PIN_AC12 -to G
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to G
# H = SW[0]
set_location_assignment PIN_AB12 -to H
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to H
# SI = SW[8]
set_location_assignment PIN_AD10 -to SI
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SI
# Clk_Inhibit = SW[9]
set_location_assignment PIN_AE12 -to Clk_Inhibit
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Clk_Inhibit
# QH = LEDR[0]
set_location_assignment PIN_V16 -to QH
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to QH
# QHn = LEDR[1]
set_location_assignment PIN_W16 -to QHn
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to QHn
