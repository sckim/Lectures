# lab08_siso_v : 4-bit SISO/SIPO shift register (Part A, Verilog), Quartus Prime Lite 18.1, DE1-SoC (5CSEMA5F31C6)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY siso_reg
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name VERILOG_FILE siso_reg.v
# ---- DE1-SoC pins (DE1-SoC User Manual rev.F, Tables 3-6, 3-7, 3-8) ----
# SI = SW[0]
set_location_assignment PIN_AB12 -to SI
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SI
# Shift = SW[1]
set_location_assignment PIN_AC12 -to Shift
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Shift
# Clock = KEY[0]
set_location_assignment PIN_AA14 -to Clock
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Clock
# ClrN = KEY[1]
set_location_assignment PIN_AA15 -to ClrN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ClrN
# Q3 = LEDR[3]
set_location_assignment PIN_V18 -to Q3
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Q3
# Q2 = LEDR[2]
set_location_assignment PIN_V17 -to Q2
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Q2
# Q1 = LEDR[1]
set_location_assignment PIN_W16 -to Q1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Q1
# Q0 = LEDR[0]
set_location_assignment PIN_V16 -to Q0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Q0
