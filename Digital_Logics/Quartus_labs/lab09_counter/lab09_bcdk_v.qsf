# lab09_bcdk_v : synchronous BCD counter on HEX0, KEY0 clock (Part E, Verilog), Quartus Prime Lite 18.1, DE1-SoC (5CSEMA5F31C6)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY bcd_hex
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name VERILOG_FILE bcd_counter.v
# ---- DE1-SoC pins (DE1-SoC User Manual rev.F, Tables 3-7, 3-8, 3-9) ----
# CLK = KEY[0]
set_location_assignment PIN_AA14 -to CLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK
# CLRN = KEY[1]
set_location_assignment PIN_AA15 -to CLRN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLRN
# HEX0[0] = HEX0[0]
set_location_assignment PIN_AE26 -to HEX0[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[0]
# HEX0[1] = HEX0[1]
set_location_assignment PIN_AE27 -to HEX0[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[1]
# HEX0[2] = HEX0[2]
set_location_assignment PIN_AE28 -to HEX0[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[2]
# HEX0[3] = HEX0[3]
set_location_assignment PIN_AG27 -to HEX0[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[3]
# HEX0[4] = HEX0[4]
set_location_assignment PIN_AF28 -to HEX0[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[4]
# HEX0[5] = HEX0[5]
set_location_assignment PIN_AG28 -to HEX0[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[5]
# HEX0[6] = HEX0[6]
set_location_assignment PIN_AH28 -to HEX0[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[6]
# LEDR[0] = LEDR[0]
set_location_assignment PIN_V16 -to LEDR[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[0]
# LEDR[1] = LEDR[1]
set_location_assignment PIN_W16 -to LEDR[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[1]
# LEDR[2] = LEDR[2]
set_location_assignment PIN_V17 -to LEDR[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[2]
# LEDR[3] = LEDR[3]
set_location_assignment PIN_V18 -to LEDR[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[3]
# C = LEDR[9]
set_location_assignment PIN_Y21 -to C
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to C
