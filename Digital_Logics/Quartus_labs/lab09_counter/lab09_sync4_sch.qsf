# lab09_sync4_sch : 4-bit synchronous binary counter, JKFF x4 + AND chain (Part D, schematic), Quartus Prime Lite 18.1, DE1-SoC (5CSEMA5F31C6)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY sync4_sch
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name BDF_FILE sync4_sch.bdf
# ---- DE1-SoC pins (DE1-SoC User Manual rev.F, Tables 3-7, 3-8) ----
# Cp = KEY[0]
set_location_assignment PIN_AA14 -to Cp
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Cp
# ClrN = KEY[1]
set_location_assignment PIN_AA15 -to ClrN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ClrN
# Qa = LEDR[0]
set_location_assignment PIN_V16 -to Qa
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Qa
# Qb = LEDR[1]
set_location_assignment PIN_W16 -to Qb
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Qb
# Qc = LEDR[2]
set_location_assignment PIN_V17 -to Qc
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Qc
# Qd = LEDR[3]
set_location_assignment PIN_V18 -to Qd
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Qd
