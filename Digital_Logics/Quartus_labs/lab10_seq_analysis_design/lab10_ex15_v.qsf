# lab10_ex15_v : Example 15-2/15-3 JK and D designs (Part C), Quartus Prime Lite 18.1, DE1-SoC (5CSEMA5F31C6)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY design15_jk_d
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name VERILOG_FILE ff_lib.v
set_global_assignment -name VERILOG_FILE design15.v
# ---- DE1-SoC pins (DE1-SoC User Manual rev.F, Tables 3-6, 3-7, 3-8) ----
# CLK = KEY[0]
set_location_assignment PIN_AA14 -to CLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK
# ClrN = KEY[1]
set_location_assignment PIN_AA15 -to ClrN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ClrN
# X = SW[0]
set_location_assignment PIN_AB12 -to X
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to X
# A_JK = LEDR[5]
set_location_assignment PIN_W19 -to A_JK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A_JK
# B_JK = LEDR[4]
set_location_assignment PIN_W17 -to B_JK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to B_JK
# A_D = LEDR[7]
set_location_assignment PIN_W20 -to A_D
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A_D
# B_D = LEDR[6]
set_location_assignment PIN_Y19 -to B_D
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to B_D
