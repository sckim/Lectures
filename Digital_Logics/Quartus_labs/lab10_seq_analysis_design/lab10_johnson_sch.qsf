# lab10_johnson_sch : Example 16-2 unused states and lockout (Part E), Quartus Prime Lite 18.1, DE1-SoC (5CSEMA5F31C6)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY johnson_lockout_sch
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name BDF_FILE johnson_lockout_sch.bdf
# ---- DE1-SoC pins (DE1-SoC User Manual rev.F, Tables 3-6, 3-7, 3-8) ----
# CLK = KEY[0]
set_location_assignment PIN_AA14 -to CLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK
# LoadN = KEY[1]
set_location_assignment PIN_AA15 -to LoadN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LoadN
# S0 = SW[0]
set_location_assignment PIN_AB12 -to S0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S0
# S1 = SW[1]
set_location_assignment PIN_AC12 -to S1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S1
# S2 = SW[2]
set_location_assignment PIN_AF9 -to S2
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S2
# C1 = LEDR[0]
set_location_assignment PIN_V16 -to C1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to C1
# B1 = LEDR[1]
set_location_assignment PIN_W16 -to B1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to B1
# A1 = LEDR[2]
set_location_assignment PIN_V17 -to A1
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A1
# C2 = LEDR[4]
set_location_assignment PIN_W17 -to C2
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to C2
# B2 = LEDR[5]
set_location_assignment PIN_W19 -to B2
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to B2
# A2 = LEDR[6]
set_location_assignment PIN_Y19 -to A2
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A2
