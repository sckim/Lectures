/*
2-to-1 multiplexer
output0 = input0 when S = 0, input1 when S = 1
        = input0 & !S | input1 & S
*/
(header "graphic" (version "1.4"))
(pin
	(input)
	(rect 40 64 208 80)
	(text "INPUT" (rect 125 0 153 10)(font "Arial" (font_size 6)))
	(text "input0" (rect 5 0 37 12)(font "Arial" ))
